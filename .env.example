# Agent configuration. For AgentBase these are set as runtime environment variables
# (see deploy/agent/README.md); for local development copy this file to .env.

# ===== LLM (GreenNode AIP) =====
LLM_API_KEY=
# LLM_BASE_URL is overridable. On AgentBase Runtime it may point to the Sidecar LLM Proxy
# (injected automatically when the agent is created): LLM_BASE_URL=http://localhost:18080
# -> verify with GreenNode for your runtime version (auth and model names may differ).
LLM_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1
LLM_MODEL=z-ai/glm-5.3-flash

# ===== Memory (Console -> AgentBase -> Memory) =====
AGENTBASE_MEMORY_ID=memory-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MEMORY_STRATEGY_ID=ltms-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx  # customer-profile (CUSTOM)

# ===== MCP: connector 'restaurant' on the Private MCP Gateway =====
# Production: <gateway Endpoint URL>/restaurant  (the MCP server key lives in Access Control, not here)
MCP_RESTAURANT_URL=https://gw-<gateway>-<id>.agentbase-gateway.aiplatform.vngcloud.vn/restaurant
# Local development (docker compose): the compose file already sets http://mcp-server:8080/mcp

# ===== Langfuse: self-hosted, private (tracing is off unless all three are set) =====
# LANGFUSE_HOST=http://<langfuse-private-ip>:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...

# ===== Zalo Bot Platform (optional: leave empty to run simulator-only) =====
ZALO_WEBHOOK_SECRET=
ZALO_BOT_TOKEN=
ZALO_API_BASE=https://bot-api.zaloplatforms.com

# ===== Local development only =====
# GREENNODE_CLIENT_ID=
# GREENNODE_CLIENT_SECRET=

# ===== Production hardening (optional) =====
# SERVE_UI=false   # set false when deployed: disables the web simulator, guests use Zalo only
# AGENT_API_KEY=   # when set, /invocations and /api/* require the X-API-Key header
# DEBUG_OPS=0      # 1 only to read the runtime principal (op whoami) for the gateway policy; turn it off afterwards

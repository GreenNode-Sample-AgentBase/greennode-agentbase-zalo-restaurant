# Copy to .env (chmod 600 .env). Never commit the real file.
# Use hex secrets (openssl rand -hex 32): they are safe inside URLs and shell commands.

# --- Network (REQUIRED) ---
# Private IP of this vServer (example value, replace it): Langfuse web is published on this address only.
LANGFUSE_BIND_ADDR=10.20.1.10
# URL admins type in the browser over the VPN. Must match how the UI is opened
# (http://<private-ip>:3000), otherwise login redirects break.
NEXTAUTH_URL=http://10.20.1.10:3000

# --- Application secrets (REQUIRED, generate each one separately) ---
NEXTAUTH_SECRET=      # openssl rand -hex 32
SALT=                 # openssl rand -hex 32   (hashes API keys: changing it invalidates existing keys)
ENCRYPTION_KEY=       # openssl rand -hex 32   (must be 64 hex characters; stored LLM credentials)

# --- Data store secrets (REQUIRED) ---
POSTGRES_PASSWORD=    # openssl rand -hex 24
CLICKHOUSE_PASSWORD=  # openssl rand -hex 24
REDIS_AUTH=           # openssl rand -hex 24
MINIO_ROOT_PASSWORD=  # openssl rand -hex 24

# --- Optional ---
# POSTGRES_VERSION=17
# CLICKHOUSE_USER=clickhouse
# MINIO_ROOT_USER=minio
# TELEMETRY_ENABLED=false         # default in this compose; set true to share anonymous usage stats

# Set true after the first admin account exists, to disable self-service sign-up.
# AUTH_DISABLE_SIGNUP=true

# Headless initialisation on first start (all optional). With these set, Langfuse creates the
# organisation, the project, the API keys and an admin user without any UI step.
# LANGFUSE_INIT_ORG_ID=restaurant
# LANGFUSE_INIT_ORG_NAME=Restaurant
# LANGFUSE_INIT_PROJECT_ID=zalo-restaurant
# LANGFUSE_INIT_PROJECT_NAME=zalo-restaurant-bot
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-<random>     # pk-lf- + openssl rand -hex 16
# LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-<random>     # sk-lf- + openssl rand -hex 32
# LANGFUSE_INIT_USER_EMAIL=admin@example.com
# LANGFUSE_INIT_USER_NAME=Admin
# LANGFUSE_INIT_USER_PASSWORD=<strong password>

# Optional SMTP for invitations and password reset.
# EMAIL_FROM_ADDRESS=langfuse@example.com
# SMTP_CONNECTION_URL=smtp://user:pass@smtp.example.com:587

# ===== LLM (GreenNode AIP) =====
LLM_API_KEY=
LLM_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1
LLM_MODEL=z-ai/glm-5.3-flash

# ===== Memory (Console → AgentBase → Memory) =====
AGENTBASE_MEMORY_ID=memory-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MEMORY_STRATEGY_ID=ltms-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx  # customer-profile (CUSTOM)

# ===== MCP (connector 'restaurant' trên MCP Gateway) =====
MCP_RESTAURANT_URL=https://gw-<gateway>-93356.agentbase-gateway.aiplatform.vngcloud.vn/restaurant

# ===== Zalo Bot Platform (tuỳ chọn — bỏ trống để chạy simulator-only) =====
ZALO_WEBHOOK_SECRET=
ZALO_BOT_TOKEN=
ZALO_API_BASE=https://bot-api.zaloplatforms.com

# ===== Chỉ cần khi CHẠY LOCAL =====
# GREENNODE_CLIENT_ID=
# GREENNODE_CLIENT_SECRET=

# ===== Production hardening (tuỳ chọn) =====
# SERVE_UI=true    # =false khi deploy: tắt web simulator, khách chỉ tương tác qua Zalo
# AGENT_API_KEY=   # đặt key này → /invocations + /api/* yêu cầu header X-API-Key
# DEBUG_OPS=0      # =1 chỉ khi cần op whoami (lấy token_sub cho policy) — tắt ngay sau đó
